<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (light) -->
    <style name="Theme.OfflineNav" parent="Theme.Material3.Light.NoActionBar">
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/nav_bar_color</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Full screen / edge-to-edge -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Splash screen theme — shown before Compose content renders -->
    <style name="Theme.OfflineNav.Splash" parent="Theme.SplashScreen">
        <!-- The splash screen icon background color -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- The splash screen animated icon (optional) -->
        <!-- <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item> -->
        <!-- Duration of the animated icon -->
        <item name="windowSplashScreenAnimationDuration">600</item>
        <!-- The theme of the Activity after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.OfflineNav</item>
    </style>

    <!-- Full-screen navigation theme (hides system bars) -->
    <style name="Theme.OfflineNav.Navigation" parent="Theme.OfflineNav">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

</resources>
